# Contact form email settings (used by src/app/api/contact/route.ts).
# Copy this file to .env.local for local development, and add the same
# variables in your hosting dashboard (e.g. Vercel → Settings → Environment Variables).
#
# Cloudflare Email Routing only RECEIVES mail for info@devopsmarkaztech.com and
# forwards it to Gmail — it cannot send. Pick ONE sending option below.

# --- Option A (recommended): Resend — https://resend.com (free: 3,000 emails/month)
# 1. Sign up, add the domain devopsmarkaztech.com and add the DNS records it shows
#    in Cloudflare (DNS → Records). Do not touch the existing Email Routing MX records.
# 2. Create an API key and paste it as SMTP_PASS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key
SMTP_FROM=website@devopsmarkaztech.com

# --- Option B: Gmail — requires 2-Step Verification on the Gmail account
# Create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=devopsmarkaz@gmail.com
# SMTP_PASS=your-16-character-app-password
# (leave SMTP_FROM unset — Gmail sends as SMTP_USER)

# Where form submissions are delivered. info@ is routed to devopsmarkaz@gmail.com by Cloudflare.
CONTACT_TO=info@devopsmarkaztech.com
