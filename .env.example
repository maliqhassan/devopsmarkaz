# SMTP settings used by the contact form (src/app/api/contact/route.ts).
# Use the mail server credentials for info@devopsmarkaztech.com.
SMTP_HOST=mail.devopsmarkaztech.com
SMTP_PORT=465
SMTP_USER=info@devopsmarkaztech.com
SMTP_PASS=your-mailbox-password

# Where contact form submissions are delivered (defaults to info@devopsmarkaztech.com)
CONTACT_TO=info@devopsmarkaztech.com
